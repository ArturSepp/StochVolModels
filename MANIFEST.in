# MANIFEST.in
# Controls what files are included in the source distribution (sdist)

# Include essential package files
include README.md
include CHANGELOG.md
include LICENSE.txt
include pyproject.toml

# Include all Python source files
recursive-include src/stochvolmodels *.py

# Source-adjacent development runners are checkout-only.
prune src/stochvolmodels/run_local
prune src/stochvolmodels/*/run_local
prune src/stochvolmodels/*/*/run_local

# Include regression baselines and other data files that the package needs
recursive-include src/stochvolmodels *.npz *.yml *.yaml *.json *.txt *.md
include src/stochvolmodels/settings.yaml.example
exclude src/stochvolmodels/settings.yaml

# Explicitly exclude repository-only examples, papers, figures, notebooks, and image files
recursive-exclude examples *
recursive-exclude papers *
recursive-exclude docs *
recursive-exclude resources *
recursive-exclude volatility_book *
recursive-exclude src/stochvolmodels/pde_solvers *

global-exclude *.png
global-exclude *.jpg
global-exclude *.jpeg
global-exclude *.gif
global-exclude *.svg
global-exclude *.pdf
global-exclude *.eps
global-exclude *.ipynb

# Exclude development and build artifacts
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude * .DS_Store
recursive-exclude * .git*
recursive-exclude * *.egg-info
global-exclude *.pyc
global-exclude *.pyo

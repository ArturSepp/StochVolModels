# MANIFEST.in
# Controls what files are included in the source distribution (sdist)

# Include essential package files
include README.md
include CHANGELOG.md
include LICENSE.txt
include pyproject.toml

# Include all Python source files
recursive-include src/stochvolmodels *.py

# Ship the numerical baseline and configuration template used by installed callers.
include src/stochvolmodels/tests/test_rough_logsv_pricer_regression/test_rough_logsv_pricer_pricing_regression.npz
recursive-exclude src/stochvolmodels README.md
include src/stochvolmodels/settings.yaml.example
exclude src/stochvolmodels/settings.yaml

# Explicitly exclude repository-only examples, papers, book analytics, figures, notebooks, and
# image files.
recursive-exclude examples *
recursive-exclude papers *
recursive-exclude volatility_book *
recursive-exclude docs *
recursive-exclude resources *
prune validation

global-exclude *.png
global-exclude *.jpg
global-exclude *.jpeg
global-exclude *.gif
global-exclude *.svg
global-exclude *.pdf
global-exclude *.eps
global-exclude *.ipynb

# Exclude development and build artifacts
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude * .DS_Store
recursive-exclude * .git*
recursive-exclude * *.egg-info
global-exclude *.pyc
global-exclude *.pyo
